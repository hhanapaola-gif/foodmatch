# Docker Compose variables for the PRIVATE server stack.
# Copy to ".env" in this same folder and fill in real secrets before deploying.
#
# IMPORTANT: DB_DATABASE / DB_USERNAME / DB_PASSWORD here MUST match the
# values in FoodMatch-Backend/.env (Laravel reads its own .env; this one
# only configures the MySQL container + is referenced by mysqld-exporter).

DB_DATABASE=foodmatch_db
DB_USERNAME=foodmatch
DB_PASSWORD=change-me-strong-password
DB_ROOT_PASSWORD=change-me-strong-root-password

REDIS_PASSWORD=change-me-strong-redis-password

MYSQL_EXPORTER_PASSWORD=change-me-strong-exporter-password
