# Copy to ".env" and point at your running FoodMatch-Backend instance.
# On a physical device/emulator "localhost" means the device itself, not
# your computer — use your machine's LAN IP (e.g. http://192.168.1.20:8000/api/v1)
# or the deployed https://tu-dominio.com/api/v1 once the backend is hosted.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
