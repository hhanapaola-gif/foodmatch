APP_NAME=Laravel
APP_ENV=local
APP_KEY=base64:HdS3j1UJe2BQde1DxUbFPTVF5SGMm9FSjHhpDt6ujTo=
APP_DEBUG=true
APP_URL=http://localhost
APP_MODE=live

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=delivery_app_db
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# When running behind the load balancer (2+ app replicas, see infra/), the
# admin panel's session-based login breaks unless sessions/cache are shared
# across containers instead of living on each container's local disk.
# Uncomment for that deployment (leave as-is for plain single-instance local dev):
# CACHE_DRIVER=redis
# SESSION_DRIVER=redis
# SESSION_CONNECTION=default

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=                    # R2 public URL: https://pub-xxx.r2.dev (NOT the r2.cloudflarestorage.com endpoint)

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
