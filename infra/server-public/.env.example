# Docker Compose variables for the PUBLIC server stack.
# Copy to ".env" in this same folder and fill in real values before deploying.
#
# 2-server topology: PRIVATE_SERVER_IP is Servidor B's private IP — it now
# hosts the app/db AND Prometheus/Grafana (colocated), so this one IP is
# used both for "/" (the LB) and "/grafana/" (Grafana).

DOMAIN=foodmatch.example.com
PRIVATE_SERVER_IP=10.0.0.2
